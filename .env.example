# SurgeGrid AI Environment Configuration (Track 5: Extreme Weather & Climate Risk Modeling)
VITE_PROJECT_ID=namma-map-407ca

# Google Maps Platform (Maps JavaScript API)
# Get a key from: https://console.cloud.google.com/google/maps-apis/credentials?project=namma-map-407ca
VITE_GOOGLE_MAPS_API_KEY=

# Gemini runs through our own proxy (gemini-proxy/, a Cloud Function that calls Gemini on Google Cloud with its
# own service account). There is NO Gemini API key in the app. Optional: point the app at a different proxy URL.
# VITE_GEMINI_PROXY_URL=/api/gemini

# --- Offline scripts under scripts/ (NOT read by Vite; do not prefix with VITE_) ---
# Export these in your shell rather than committing values. See scripts/README.md.
# GEMINI_API_KEY=
# IG_SESSIONID=
# IG_CSRFTOKEN=
# IG_DS_USER_ID=
# IG_IG_DID=
# IG_MID=
# IG_DATR=
# IG_RUR=
# IG_FB_LSD=
# X_BEARER_TOKEN=
# X_CT0=
# X_AUTH_TOKEN=
